# Leave unset (or empty) to use Vite's dev proxy (see vite.config.ts) — requests to
# /api/* are forwarded to the WarehouseApi backend and appear same-origin to the browser.
#
# Set this only when the frontend is served from a different origin than the API
# (e.g. a production deployment where they're on separate domains). In that case the
# backend's CORS AllowedOrigins and cookie SameSite=None settings both need to agree
# with this value.
# VITE_API_URL=https://api.example.com
